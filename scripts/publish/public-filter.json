{
  "_comment": [
    "Public distribution policy shared by source export and Electron builds.",
    "Enterprise implementations and Full operator guides use explicitly reviewed replacements.",
    "Root files, authoring areas and npm commands are allowlisted. Unknown files in those areas are private by default.",
    "Public README and operator guides use reviewed replacements; Full upgrade and publishing instructions stay in Full."
  ],
  "deny": [
    "mci-server/**",
    "**/[Mm]ci*",
    "**/*[Mm]ci*.{js,mjs,vue,json,md,sql,cjs}",
    "src/core/mci/**",
    "docs/MCI_*",
    "docs/TUTORIAL_03_MCI_CONTROLLER.md",
    "docs/answers/mci/**",
    "docs/tutorial-src/build-mci-tutorial.cjs",
    "docs/aidot-express-mci-tutorial-*",
    "legacy/**",
    "src/core/ha/**",
    "docs/HA_*",
    "docs/aidot-express-ha-tutorial-*",
    "**/Ha{Page,Controller,Service}*",
    "scripts/ha-*",
    "tests/ha-*",
    "**/[Bb]ackup{Page,Controller,Service}*",
    "scripts/backup-secure-check.mjs",
    "tests/backup-secure.test.mjs",
    "docs/BACKUP_*",
    "**/Secure{Column,Member}*",
    "src/secure/**",
    "src/database/sql/secure_member.sql",
    "docs/SECURE_*",
    ".env.secure.example",
    "**/.env",
    "**/.env.local",
    "dist-electron/**",
    "log/**",
    "data/**",
    "lib/admin/service/mci/**",
    "tests/tutorial-fixes.test.mjs",
    "docs/tutorial-src/**",
    "docs/answers/**",
    "CHANGELOG.md",
    "APPLY-PATCH.md",
    "docs/PUBLISHING.md",
    "scripts/mci-*",
    "scripts/ha-*",
    "scripts/backup-*",
    "scripts/*-drill.mjs",
    "scripts/*-check.mjs",
    ".env.enterprise.example",
    ".env.secure.example",
    "examples/**",
    "client/**",
    "tests/_mci-*",
    ".electron-builder.*.json",
    ".eb-*.json",
    "mci-server/samples/**",
    "**/*.__full/**",
    "**/*.__full",
    "stubs/**",
    "admin-client/dist/**",
    "admin-client/dist-public/**",
    "docs/REVIEW_1.43.0_KO.md",
    "public/assets/**",
    "scripts/git-*.mjs",
    "scripts/release*.mjs",
    "scripts/publish/export-public.mjs",
    "scripts/publish/sync-public.mjs",
    "scripts/tutorial/**",
    "src/controller/{BloodPressure,BloodSugar,Weight,Person}Controller.js",
    "src/service/{BloodPressure,BloodSugar,Weight,Person}Service.js",
    "src/database/sql/{bloodPressure,bloodSugar,weight,person}.sql",
    "src/database/migrations/009_samples_deprecated.sql",
    "public/uploads/**"
  ],
  "scan": {
    "_comment": [
      "PII scanning is a heuristic release gate, not proof of absence of sensitive data."
    ],
    "koreanPatient": "환자\\s*(명|이름|번호|ID)\\s*[:=]\\s*[\"']?[가-힣0-9]{4,}",
    "hospitalNames": "(삼성서울|서울대학교병원|서울아산|세브란스|의료원)",
    "mciTelegram": "cfs_(bheader|sheader)_"
  },
  "scanExempt": [
    "scripts/publish/**",
    "docs/LICENSING.md",
    "src/config/default.js",
    "src/config/index.js"
  ],
  "maxDataFileBytes": 51200,
  "allowOnly": {
    "_comment": [
      "All matching scopes apply. Explicit deny rules take precedence over allowOnly; Enterprise and documentation replacements must be declared as stubs."
    ],
    "docs/**": [
      "docs/ARCHITECTURE.md",
      "docs/LICENSING.md",
      "docs/BUILD_AND_RELEASE.md",
      "docs/SECURITY_OPERATIONS.md",
      "docs/UPGRADE.md",
      "docs/WINDOWS_OPERATIONS.md",
      "docs/aidot-express-tutorial-v1.32.0.pdf",
      "docs/aidot-express-tutorial-v1.32.0_ko.pdf",
      "docs/HTTPS.md",
      "docs/SERVER_INSTALL.md"
    ],
    "tests/**": [
      "tests/security-hardening.test.mjs",
      "tests/startup-dependencies.test.mjs",
      "tests/cors-compat.test.mjs",
      "tests/external-server.test.mjs",
      "tests/sqlite-dialect.test.mjs",
      "tests/handler-signature.test.mjs",
      "tests/route-collision.test.mjs",
      "tests/table-prefix.test.mjs",
      "tests/migration-recover.test.mjs",
      "tests/https.test.mjs",
      "tests/server-package.test.mjs"
    ],
    "*": [
      ".env.example",
      ".gitattributes",
      ".gitignore",
      "LICENSE",
      "NOTICE",
      "README.md",
      "package.json",
      "package-lock.json",
      "tsconfig.json"
    ],
    "scripts/**": [
      "scripts/start.mjs",
      "scripts/startup-dependencies.mjs",
      "scripts/build-edition.mjs",
      "scripts/build-linux.mjs",
      "scripts/linux-artifacts.mjs",
      "scripts/ensure-build-deps.mjs",
      "scripts/verify-edition-package.cjs",
      "scripts/verify-packed-edition.cjs",
      "scripts/verify-env.mjs",
      "scripts/electron-dev.cjs",
      "scripts/electron-dev-vite.cjs",
      "scripts/electron-smoke.cjs",
      "scripts/logs.mjs",
      "scripts/check-syntax.mjs",
      "scripts/check-vue-refs.mjs",
      "scripts/check-self-calls.mjs",
      "scripts/check-sql-names.mjs",
      "scripts/check-sfc.mjs",
      "scripts/check-render.mjs",
      "scripts/check-i18n.mjs",
      "scripts/check-vue-trace.py",
      "scripts/security-e2e.mjs",
      "scripts/publish/policy.mjs",
      "scripts/publish/public-filter.json",
      "scripts/publish/pii-scan.mjs",
      "scripts/windows/aidot-express.xml",
      "scripts/windows/install-service.ps1",
      "scripts/windows/uninstall-service.ps1",
      "scripts/https-cert.mjs",
      "scripts/server/**"
    ],
    "workspace/**": [
      "workspace/README.md"
    ],
    "public/**": [
      "public/favicon.svg",
      "public/index.html",
      "public/demo/guestbook-lab.html",
      "public/demo/upload-lab.html",
      "public/vendor/bootstrap.min.css",
      "public/vendor/vue.esm-browser.prod.js"
    ],
    "admin-client/**": [
      "admin-client/.gitignore",
      "admin-client/README.md",
      "admin-client/package.json",
      "admin-client/package-lock.json",
      "admin-client/index.html",
      "admin-client/edition-plugin.js",
      "admin-client/vite.config.js",
      "admin-client/vite.public.js",
      "admin-client/src/**",
      "admin-client/public/**"
    ]
  },
  "warn": {
    "_comment": [
      "Not blocking, but shown after a successful run.",
      "Korean comments are fine internally; in a public repository they narrow the audience."
    ],
    "koreanComment": "^\\s*(#|//|\\*|/\\*)[^\\n]*[\\uAC00-\\uD7A3]"
  },
  "warnScope": [
    "*.md",
    ".env.example",
    "README.md",
    "NOTICE"
  ],
  "stubs": {
    "_comment": [
      "Replace these implementations with the matching stubs. Missing stubs are never copied from full source."
    ],
    "dirs": [
      "src/core/ha",
      "src/secure"
    ],
    "files": [
      "lib/admin/service/BackupService.js",
      "README.md",
      "docs/BUILD_AND_RELEASE.md",
      "docs/UPGRADE.md",
      "docs/WINDOWS_OPERATIONS.md",
      "docs/SECURITY_OPERATIONS.md",
      "docs/SERVER_INSTALL.md"
    ]
  },
  "sourceRoots": [
    "admin-client",
    "docs",
    "electron",
    "lib",
    "public",
    "scripts",
    "src",
    "tests",
    "workspace"
  ],
  "publicScripts": [
    "start",
    "start:server",
    "start:main",
    "dev",
    "check",
    "test",
    "test:electron",
    "electron:dev",
    "electron:dev:vite",
    "build:admin",
    "build:electron",
    "dist:win",
    "dist:win:ia32",
    "pack",
    "check:vue",
    "check:sfc",
    "check:render",
    "check:ui",
    "logs",
    "check:i18n",
    "check:env",
    "check:refs",
    "check:self",
    "check:sqlnames",
    "dist:linux",
    "dist:all",
    "license:report",
    "ensure:deps",
    "check:security",
    "test:security:e2e",
    "electron:install",
    "https:cert",
    "https:check",
    "dist:server:win",
    "dist:server:linux",
    "server:configure",
    "server:run",
    "server:health"
  ]
}
