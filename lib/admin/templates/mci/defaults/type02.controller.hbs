import {
  Controller,
  Log,
  Autowired,
  PostMapping,{{#if auth}}
  Auth,{{/if}}
} from '{{{decoratorsImport}}}';


@Controller('{{basePath}}')
export default class {{controllerName}} {

  @Autowired('MciService') mciService;

  @Log log;

  // POST {{basePath}}  →  {{controllerName}}.call
  // MCI interface: {{interfaceId}}
  // 응답 구조: {{responseBlockName}} → {{innerBlockName}}[]
  @PostMapping('/'){{#if auth}}
  @Auth(){{/if}}
  async call(params, req) {
    this.log.info(`${this.constructor.name}::call 호출됨 -> interfaceId={{interfaceId}}`);

    // ── Client → MCI 요청 body 조립 (플랫 IN)
    const input = { {{#each inputMapping}}
      {{mciName}}: params.{{apiName}},{{#if desc}}     // {{desc}}{{/if}}{{/each}}
    };

    // ── MCI 서버로 전송 (응답 외부 블록까지 받음)
    const { data: outer, mciMessage, meta } = await this.mciService.call({
      interfaceId: '{{interfaceId}}',
      requestBlockName: '{{requestBlockName}}',
      responseBlockName: '{{responseBlockName}}',
      input,
      req,
    });

    // ── 응답 2-레벨 중첩 해제: outer.{{innerBlockName}} 배열을 꺼내 매핑 적용
    const list = outer?.{{innerBlockName}} ?? [];
    const data = Array.isArray(list) ? list.map((row) => ({ {{#each outputMapping}}
      {{apiName}}: row.{{mciName}},{{#if desc}}   // {{desc}}{{/if}}{{/each}}
    })) : list;

    return { data, mciMessage, meta };
  }
}
