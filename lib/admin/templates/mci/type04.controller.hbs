@Controller('{{basePath}}')
export default class {{controllerName}} {

  @Autowired('MciService') mciService;

  @Log log;

  // POST {{basePath}}  →  {{controllerName}}.call
  // MCI interface: {{interfaceId}}
  //   요청 구조:
  //     {{requestBlockName}}
  //       ├─ {{masterBlockName}}    (진료/환자 정보 등 단건)
  //       └─ {{detailContainerName}}
  //             ├─ afiReptNtm       (디테일 건수)
  //             └─ {{detailBlockName}}: [디테일 배열]
  @PostMapping('/'){{#if auth}}
  @Auth(){{/if}}
  async call(params, req) {
    this.log.info(`${this.constructor.name}::call 호출됨 -> interfaceId={{interfaceId}}`);

    // ── 디테일 배열 변환 (클라이언트가 보낸 orderList → MCI 디테일 구조)
    const detailList = Array.isArray(params.{{detailParamName}}) ? params.{{detailParamName}} : [];
    const detailRows = detailList.map((item) => ({ {{#each detailItemMapping}}
      {{mciName}}: item.{{apiName}},{{#if desc}}   // {{desc}}{{/if}}{{/each}}
    }));

    // ── 마스터 + 디테일 블록 조립
    const input = {
      {{masterBlockName}}: { {{#each masterMapping}}
        {{mciName}}: params.{{apiName}},{{#if desc}}   // {{desc}}{{/if}}{{/each}}
      },
      {{detailContainerName}}: {
        afiReptNtm: detailRows.length,
        {{detailBlockName}}: detailRows,
      },
    };

    // ── MCI 서버로 전송
    const { data, mciMessage, meta } = await this.mciService.call({
      interfaceId: '{{interfaceId}}',
      requestBlockName: '{{requestBlockName}}',
      responseBlockName: '{{responseBlockName}}',
      input,
      req,
      outputMapping: { {{#each outputMapping}}
        {{apiName}}: '{{mciName}}',{{#if desc}}   // {{desc}}{{/if}}{{/each}}
      },
    });

    return { data, mciMessage, meta };
  }
}
