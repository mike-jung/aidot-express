# ============================================================
#  aidot-express — environment settings (.env)
#
#  Copy this file to .env and change the values.
#  (`npm start` copies it for you if .env is missing.)
#
#  Everything here has a working default except the database
#  connection — that one you must set.
# ============================================================

# ============================================================
#  aidot-express — environment settings (.env)
#   · Copy this file to .env and change the values (npm start copies it if .env is missing)
#   · Never commit .env — it is already in .gitignore
#   · A commented-out line shows the default; uncomment only to change it
# ============================================================

NODE_ENV=development
PORT=7901
# Loopback by default for local development; choose an explicit interface for a server.
HOST=127.0.0.1

# Console default language: en | ko
#   Whatever the user picks at login or in Settings wins over this.
LOCALE=en


# ── Database connection ──────────────────────────────────────────────────
#   DB_TYPE: mariadb | mysql | sqlite | oracle   (recommended: MariaDB 11.8 LTS or 12.3 LTS)
#   To try SQLite, set DB_TYPE=sqlite and nothing else
#   (omit DB_FILE and it is created at data/app.db; other DB_* values are ignored)
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=admin

# Schema used by the framework itself — admin accounts, access logs, request traces.
DB_DATABASE=aidot_express

# Missing schemas are created at startup (DB_DATABASE, DB_APP_SCHEMA, DB_SAMPLE_SCHEMA).
#   If the DB account has no CREATE privilege in production, set this false and create them yourself:
#     CREATE DATABASE `aidot_express` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     GRANT ALL PRIVILEGES ON `aidot_express`.* TO 'aidot'@'%';
DB_AUTO_CREATE_DATABASE=true

DB_CONN_LIMIT=10
# DB_SSL=false                 # true connects over TLS (server certificate verified)
# DB_TIMEZONE=local            # local | Z | +09:00
# DB_CONNECT_TIMEOUT_MS=10000
# DB_ACQUIRE_TIMEOUT_MS=10000
# DB_FILE=data/app.db          # sqlite only (':memory:' for tests)


# ── Which schema holds which tables ─────────────────────────────────────────
#   There are three kinds of table, and each can live in its own schema.
#     1. Framework tables  admin_* · access_logs · request_traces …  ->  DB_DATABASE
#     2. Sample tables     book · guestbook · students …             ->  DB_SAMPLE_SCHEMA
#     3. Your tables       whatever you create (snack · supply …)    ->  DB_APP_SCHEMA

# 3. Schema for your own tables.
#    Generated SQL is qualified with it (FROM aidot_app.snack), and column lists are read from it.
#    Also changeable in the console: Settings -> Workspace -> DB schema.
#      · Leave empty to use the same schema as the framework tables (DB_DATABASE).
#      · Changing it does not move existing tables. Create them again, or move them yourself.
#      · Do not use the sample schema for real work — its tables are recreated at startup.
DB_APP_SCHEMA=aidot_app

# 2. How many sample tables to create
#     core (default)  only what the tutorial needs — book · guestbook · students
#     all             everything (currently the same as core)
#     none            create nothing
#   Set it to none once this becomes a real project. Existing sample tables are left alone.
DB_SAMPLES=core

# Put samples in their own schema (MariaDB/MySQL only)
#   true  -> created as sample.book, invisible from other schemas
#   false -> created as sample_book inside DB_DATABASE, using a prefix
#   SQLite has no schemas, so it always uses the prefix.
DB_SAMPLE_SCHEMA_SEPARATE=true
DB_SAMPLE_SCHEMA=sample

# Prefix for sample tables when the prefix form is used (setting above false, or SQLite).
#   Framework tables (admin_* · users · refresh_tokens) are not affected.
DB_SAMPLE_PREFIX=sample_


# ── Where your own files are stored ─────────────────────────────────────────
#   Controllers, services, SQL and scenarios you create go here (workspace/controller, …).
#   They stay separate from the bundled examples in src/, and the lists have a "mine only" switch.
#   Leave empty to store them under src/ with the examples. Also changeable in Settings -> Workspace.
#
#   Several folders can be listed, separated by commas. Later entries win when a name
#   appears twice, so put the one you edit most at the end:
#       APP_WORKSPACE=workspace,\\\\fileserver\\shared\\aidot
#
#   An installed build always adds %APPDATA%\Aidot Express\workspace at the end, because
#   the install folder itself is read-only. You do not need to list it.
APP_WORKSPACE=workspace


# ── Authentication ────────────────────────────────────────────────────────────────────
# Replace this with a random string of at least 32 characters.
#   Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_SECRET=CHANGE_ME_IN_ENV_FILE_MINIMUM_32_CHARS_LONG!
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=7d

# true when served over HTTPS (including TLS terminated at a reverse proxy)
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=strict  # strict | lax | none

# Allow app users to sign themselves up — false if your app has no self-service signup
AUTH_SIGNUP_OPEN=true
# Allow creating console accounts without authentication — only briefly, during first setup on a closed network
ADMIN_SIGNUP_OPEN=false

# Minimum console password length (letters + digits required, and it may never contain the username)
AUTH_MIN_PASSWORD_LENGTH=10

# Lockout after failed logins
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCK_MINUTES=15

# First admin account (used once, only when admin_users is empty)
#   development : omit these and admin / admin1234 is created; the console shows a reminder
#   production  : omit these and a random password is saved in a local initial-credentials file
# Initial passwords show a warning and do not block authorized console, control or SSE APIs.
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=

# Rate limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MIN=15
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_WINDOW_MIN=15
# AUTH_RATE_LIMIT_MAX=10
# AUTH_ISSUER=aidot-express
# SECURITY_CSP=false


# ── Network ────────────────────────────────────────────────────────────────
# Only when behind a reverse proxy (Nginx/Caddy/IIS ARR): 1 | true | loopback | 10.0.0.0/8
TRUST_PROXY=false
# Exact trusted HTTP(S) origins, comma separated. Empty permits same-origin console use.
# Legacy * entries are ignored with a warning; they never allow arbitrary origins.
CORS_ORIGIN=
# BODY_LIMIT=10mb
#
#   There are two upload routes.
#     · POST /api/uploads/           file as base64 inside JSON (the body grows by about a third)
#     · POST /api/uploads/multipart  ordinary multipart/form-data (browser <form>, curl -F)
#   The multipart limit is set separately below (20 MB by default).
# UPLOAD_MAX_BYTES=20971520


# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Log every SQL statement (development only)
LOG_SQL=false
# Also log the console's own requests (/api/admin/*) — this makes logs much larger
LOG_ADMIN=false
# Framework internals (trace steps, SSE publishing) — only when debugging those
LOG_INTERNAL=false

# Size limit per log file. Beyond it, files continue as 2026-08-27.1.log
LOG_MAX_SIZE=50m
# How much the console reads in one pass (newest file first, reading from the end)
LOG_QUERY_MAX_MB=64
LOG_FACETS_MAX_MB=16
LOG_FILE_MAX_MB=32
# Scan logs on a worker thread — the server stays responsive while a large log is searched
LOG_SCAN_WORKER=true
# Searches longer than this are cancelled and answered with 408
LOG_SCAN_TIMEOUT_MS=15000
# Roles allowed to open the Logs screen (comma separated: admin,user)
LOG_VIEW_ROLES=admin

# Retention for access statistics and load monitoring
ACCESS_MAX_RECORDS=1000000
METRICS_MAX_RECORDS=500000
METRICS_RETENTION_DAYS=30

# Retention for request traces
TRACE_RETENTION_DAYS=30        # delete records older than this (0 = off)
TRACE_MAX_RECORDS=200000       # delete oldest beyond this count (0 = off)
TRACE_RING_MAX=1000            # recent requests kept in memory (including ones never written to the DB)


#   How often the statistics screen is told something changed (it backs off when busy)
#   MIN when idle, up to MAX past BUSY_RPS requests per second. Each notice costs the screen several aggregate queries.
# ACCESS_NOTIFY_MIN_MS=1500
# ACCESS_NOTIFY_MAX_MS=10000
# ACCESS_NOTIFY_BUSY_RPS=20




# ── Supervisor / control API ───────────────────────────────────────────────────
#   Used by Stop / Start / Restart in the console. Bound to 127.0.0.1 only.
CONTROL_ENABLED=true
CONTROL_PORT=7902
CONTROL_HOST=127.0.0.1

# Liveness watch — polls /health/live; if it stops answering, the stack at the stall is logged and
#   the server is restarted (10s x 6 ~ 1 min). If restarts exceed the hourly limit it stops and reports.
# SUPERVISOR_WATCHDOG=true
# SUPERVISOR_WATCHDOG_INTERVAL_MS=10000
# SUPERVISOR_WATCHDOG_TIMEOUT_MS=3000
# SUPERVISOR_WATCHDOG_FAILURES=6
# SUPERVISOR_RESTART_ON_EXIT=true
# SUPERVISOR_MAX_RESTARTS_PER_HOUR=10
# Opens a debug port only when a stack dump is needed (127.0.0.1 only). Set false if your policy forbids it
# SUPERVISOR_HANG_DUMP=true
# SUPERVISOR_INSPECT_PORT=0     # 0 means the server port + 2000


# ── Middleware integration (enterprise edition) ──────────────────────
#   Talks to hospital middleware using fixed-length headers plus JSON payloads.
#   Leave it off. The screens are not bundled in this edition, so turning it on
#   would only add menus that lead nowhere.
# Middleware (MCI) generator — an enterprise feature.
# Leave this false. Turning it on without the enterprise edition installed
# shows menus whose screens are not bundled.
EAI_ENABLED=false

# Direct HTTPS for the main server and Control server (same PORT / CONTROL_PORT).
# Generate a private CA and server certificate without installing OpenSSL:
#   npm run https:cert -- --hosts localhost,127.0.0.1,::1 --apply
# Add the deployment hostname/IP to --hosts. Restart the complete app/service after changes.
# Import only ca.crt into each browser/OS trust store; never distribute server.key.
# Relative paths below are resolved from the directory containing the active .env file.
HTTPS_ENABLED=false
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=
HTTPS_CA_FILE=
# Optional passphrase for an encrypted PEM private key. Never commit real secrets.
HTTPS_KEY_PASSPHRASE=
# Optional certificate SAN name for internal health checks (auto-detected when empty).
HTTPS_SERVER_NAME=
# TLS 1.2 or later is required. Direct HTTPS always enables Secure authentication cookies.
# For public Internet deployments, use a publicly trusted certificate and its complete chain.

# Optional Electron client attachment to an independently managed HTTPS server.
# These client settings never require a server private key or DB credentials.
# AIDOT_SERVER_URL=https://localhost:7901
# AIDOT_SERVER_CA_FILE=C:/AidotClient/ca.crt
# Or use a separate client-only dotenv file with the two settings above:
# AIDOT_CLIENT_ENV_FILE=C:/AidotClient/client.env
# Omit the CA file for certificates trusted by the client's normal Node trust store.

# Optional service state root. Keep it outside the application directory.
# AIDOT_DATA_DIR=C:/ProgramData/AidotExpressServer-public
